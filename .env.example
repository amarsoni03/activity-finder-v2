# GEMINI_API_KEY / VITE_GEMINI_API_KEY: Required for Gemini AI API calls.
# On Vercel, set VITE_GEMINI_API_KEY in your Project Settings -> Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SITE PASSWORD PROTECTION (FOR VERCEL / PRODUCTION DEPLOYMENTS)
# VITE_SITE_PASSWORD: The custom access password required to unlock the site.
# Multiple passwords can be comma-separated (e.g. "secret123,team2025").
# Default fallbacks if omitted on Vercel: "activity2025", "preview"
VITE_SITE_PASSWORD="your-secure-password"

# VITE_ENABLE_PASSWORD_PROTECTION: Force enable password gate even on local dev / custom domains
# Values: "true" | "false" (automatically enabled on *.vercel.app)
VITE_ENABLE_PASSWORD_PROTECTION="true"
