# GEMINI_API_KEY: Required for Gemini AI API calls (Server-side only).
# NEVER expose your API key with VITE_ prefix, as VITE_ variables are bundled into client JS.
# On Vercel: Set GEMINI_API_KEY in Project Settings -> Environment Variables.
# Local Development: Create a .env.local file and set GEMINI_API_KEY="your_api_key_here".
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: Optional URL where this app is hosted.
APP_URL="http://localhost:3000"

